# Copy this file to .env.local and fill in your Supabase project credentials.
# Find these under Project Settings > API in your Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required for account deletion. Find this under Project Settings > API >
# service_role key. Keep this secret, never expose it with a NEXT_PUBLIC_
# prefix or in client code, it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: your deployed app URL, used to build the password reset email
# link. On Vercel this falls back to VERCEL_URL automatically if unset.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
