# Copy this file to .env.local and fill in your Supabase project credentials.
# Find these under Project Settings > API in your Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: your deployed app URL, used to build the password reset email
# link. On Vercel this falls back to VERCEL_URL automatically if unset.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
